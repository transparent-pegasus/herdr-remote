# cp .env.example .env and fill in. .env is git-ignored.

# Remotely-managed tunnel token from the Cloudflare Zero Trust dashboard.
# Point its public hostname at http://127.0.0.1:$PORT, and put Access in front of it.
CLOUDFLARE_TUNNEL_TOKEN=

# Host headers the server will answer to, comma-separated. Cloudflare Access
# guards the tunnel, not this socket, so pinning the hostname is what stops a
# DNS-rebinding page from reaching 127.0.0.1 through the victim's browser.
# Loopback is always accepted, so local `make run` keeps working regardless.
# Set this to your tunnel public hostname before `make deploy`.
ALLOWED_HOSTS=

# Loopback port the server listens on. Never bind 0.0.0.0.
PORT=8787

# cp .env.example .env and fill in. .env is git-ignored.

# Remotely-managed tunnel token from the Cloudflare Zero Trust dashboard.
# Point its public hostname at http://127.0.0.1:$PORT, and put Access in front of it.
CLOUDFLARE_TUNNEL_TOKEN=

# Loopback port the server listens on. Never bind 0.0.0.0.
PORT=8787

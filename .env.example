# cp .env.example .env and fill in. .env is git-ignored.

# Remotely-managed tunnel token from the Cloudflare Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# Address to listen on. Default 127.0.0.1 is right for a public hostname, where
# cloudflared reaches the server over loopback. A Zero Trust *private network*
# route instead needs an address the WARP client can be routed to, so add an
# alias on `lo` and bind that (see README) — it stays unreachable from the LAN.
#   sudo ip addr add 10.99.99.1/32 dev lo
#   BIND_ADDR=10.99.99.1
# Never 0.0.0.0: nothing in front of this socket authenticates.
BIND_ADDR=

# Extra Host headers to answer to, comma-separated. Access guards the tunnel,
# not this socket, so pinning the hostname is what stops a DNS-rebinding page
# from reaching the server through the victim's browser. Loopback and BIND_ADDR
# are always accepted, so this is only needed for a public hostname.
ALLOWED_HOSTS=

# Port the server listens on.
PORT=8787

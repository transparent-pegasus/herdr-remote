<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#05c6ac" />
    <link rel="icon" href="/favicon.png" />
    <title>Herdr Remote</title>
  </head>
  <body>
    <header>
      <a id="back" href="/" hidden aria-label="Back">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="m12 19-7-7 7-7" /><path d="M19 12H5"
        /></svg>
      </a>
      <h1 id="heading">Herdr Remote</h1>
      <button id="refresh" type="button" aria-label="Reload">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1.06 6.74 2.74L21 8" /><path
            d="M21 3v5h-5"
        /></svg>
      </button>
    </header>

    <noscript>This page needs JavaScript to list panes and send prompts.</noscript>
    <p id="status" role="status"></p>
    <div id="list"></div>
    <div id="logarea">
      <button id="more" type="button" hidden aria-label="Load earlier">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1.06 6.74 2.74L21 8" /><path
            d="M21 3v5h-5"
        /></svg>
      </button>
      <ol id="transcript" hidden></ol>
      <pre id="log" hidden></pre>
    </div>
    <dialog id="full">
      <div class="body" tabindex="-1"></div>
      <button id="full-close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </dialog>
    <div id="live" hidden>
      <span id="beat" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-label="working"><g>
          <path d="m14 13-8.381 8.38a1 1 0 0 1-3.001-3l8.384-8.381"/>
          <path d="m16 16 6-6"/><path d="m21.5 10.5-8-8"/>
          <path d="m8 8 6-6"/><path d="m8.5 7.5 8 8"/>
        </g></svg>
      </span>
      <span id="draft"></span>
      <button id="expand" type="button" aria-label="Watch the pane">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>
    <dialog id="screen">
      <div class="body" tabindex="-1"><pre></pre></div>
      <button id="screen-close" type="button" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </dialog>

    <form id="composer">
      <label for="text" id="target"></label>
      <textarea
        id="text"
        rows="2"
        disabled
        placeholder="Type an instruction…"></textarea>
      <div id="actions">
        <button
          id="stop"
          type="button"
          disabled
          data-icon="hand"
          aria-label="Stop"
          title="Stop"
        >
          <svg class="hand" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M18 11V6a2 2 0 0 0-4 0v5" /><path
              d="M14 10V4a2 2 0 0 0-4 0v6" /><path
              d="M10 10.5V6a2 2 0 0 0-4 0v8" /><path
              d="M6 14v-2a2 2 0 1 0-4 0v2" /><path
              d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-6-2L2.59 16.6A2 2 0 0 1 5.42 13.77L7 15.34"
          /></svg>
          <svg class="eraser" viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="m7 21-4.3-4.3c-.9-.9-.9-2.3 0-3.2l9.6-9.6c.9-.9 2.3-.9 3.2 0l4.6 4.6c.9.9.9 2.3 0 3.2L11.8 21" /><path
              d="M22 21H7" /><path d="m5 11 9 9"
          /></svg>
        </button>
        <button id="go" type="button" disabled aria-label="Send go" title="go">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M7 10v12" /><path
              d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"
          /></svg>
        </button>
        <button
          id="push"
          type="button"
          disabled
          aria-label="Send don't stop until completion"
          title="don't stop until completion"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" /><path
              d="m12 15-3-3a22 22 0 0 1 2-3.95A12.87 12.87 0 0 1 22 2c0 2.72-.78 7.5-6.05 11a22.35 22.35 0 0 1-3.95 2z" /><path
              d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" /><path
              d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" /><circle
              cx="16"
              cy="8"
              r="1"
          /></svg>
        </button>
        <div id="nav">
          <button id="up" type="button" disabled aria-label="Up" title="Up">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="m18 15-6-6-6 6"
            /></svg>
          </button>
          <button id="down" type="button" disabled aria-label="Down" title="Down">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="m6 9 6 6 6-6"
            /></svg>
          </button>
        </div>
        <button type="submit" class="empty" disabled aria-label="Enter" title="Enter">
          <svg class="send" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" /><path
              d="m21.854 2.147-10.94 10.939"
          /></svg>
          <svg class="enter" viewBox="0 0 24 24" aria-hidden="true"
            ><polyline points="9 10 4 15 9 20" /><path d="M20 4v7a4 4 0 0 1-4 4H4"
          /></svg>
        </button>
      </div>
    </form>

    <script>
      import {
        closePane,
        fetchAgentTick,
        fetchOutput,
        fetchSession,
        fetchTranscript,
        forgetPane,
        isTransient,
        interruptPane,
        type Live,
        openPane,
        paneSubtitle,
        paneTitle,
        pressArrow,
        pressEnter,
        sendPrompt,
        stateIndicator,
        stopPresentation,
        type Pane,
        type Session,
        type StateIndicator,
        type Tab,
        type Workspace,
      } from "../lib/api";
      import { href, parseRoute, type Route } from "../lib/route";
      import {
        agentRawState,
        type Card,
        following,
        modalContent,
        prepend,
        replaceTail,
      } from "../lib/transcript";

      const listEl = document.querySelector<HTMLDivElement>("#list")!;
      const logEl = document.querySelector<HTMLPreElement>("#log")!;
      const moreEl = document.querySelector<HTMLButtonElement>("#more")!;
      const statusEl = document.querySelector<HTMLParagraphElement>("#status")!;
      const headingEl = document.querySelector<HTMLHeadingElement>("#heading")!;
      const backEl = document.querySelector<HTMLAnchorElement>("#back")!;
      const composerEl = document.querySelector<HTMLFormElement>("#composer")!;
      const targetEl = document.querySelector<HTMLLabelElement>("#target")!;
      const textEl = document.querySelector<HTMLTextAreaElement>("#text")!;
      const sendEl = composerEl.querySelector<HTMLButtonElement>(
        "button[type=submit]",
      )!;
      const stopEl = document.querySelector<HTMLButtonElement>("#stop")!;
      const goEl = document.querySelector<HTMLButtonElement>("#go")!;
      const pushEl = document.querySelector<HTMLButtonElement>("#push")!;
      const upEl = document.querySelector<HTMLButtonElement>("#up")!;
      const downEl = document.querySelector<HTMLButtonElement>("#down")!;
      const refreshEl = document.querySelector<HTMLButtonElement>("#refresh")!;
      const transcriptEl =
        document.querySelector<HTMLOListElement>("#transcript")!;
      const fullEl = document.querySelector<HTMLDialogElement>("#full")!;
      const fullBodyEl = fullEl.querySelector<HTMLDivElement>(".body")!;

      let cards: Card[] = [];
      let paintedCards: Card[] = [];

      function cardEl(card: Card) {
        const item = document.createElement("li");
        item.dataset.role = card.role;
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.seq = String(card.seq);
        const preview = document.createElement("p");
        preview.className = "preview";
        // textContent: a preview is the speaker's words, not our markup.
        preview.textContent = card.preview;
        button.append(preview);
        item.append(button);
        return item;
      }

      /** Rebuild only when the merge produced a different array. Thirty nodes is
       *  cheap; yanking the reader's scroll position every three seconds is not. */
      function paintCards() {
        if (cards === paintedCards) return;
        const follow = following(
          transcriptEl.scrollTop,
          transcriptEl.clientHeight,
          transcriptEl.scrollHeight,
        );
        const top = transcriptEl.scrollTop;
        transcriptEl.replaceChildren(moreEl, ...cards.map(cardEl));
        paintedCards = cards;
        transcriptEl.scrollTop = follow ? transcriptEl.scrollHeight : top;
      }

      /** The control rides at the top of whichever view is scrolling. The card
       *  list can hold it as a child; the raw log is a single text node that
       *  `paint()` replaces, so there it sits directly above instead. */
      function parkMore(inTranscript: boolean) {
        const home = inTranscript ? transcriptEl : logareaEl;
        if (moreEl.parentElement !== home) home.prepend(moreEl);
      }

      // The agent's HTML was rendered by the server, which escapes raw HTML and
      // strips dangerous link and image schemes; the user's own text arrives escaped
      // by the same server, so both are safe to assign and neither is re-escaped.
      function openCard(card: Card) {
        const { wrap, html } = modalContent(card);
        fullBodyEl.classList.toggle("wrap", wrap);
        fullBodyEl.innerHTML = html;
        fullBodyEl.scrollTop = 0;
        sizeSheets();
        // showModal(): reading a message is a detour from driving the pane, so
        // the controls below go inert the way they are outside a pane. Escape
        // and the focus trap come with it.
        fullEl.showModal();
        fullBodyEl.focus();
      }

      transcriptEl.addEventListener("click", (event) => {
        const button = (event.target as Element | null)?.closest<HTMLButtonElement>(
          "button[data-seq]",
        );
        const seq = Number(button?.dataset.seq);
        const card = cards.find((candidate) => candidate.seq === seq);
        if (card) openCard(card);
      });

      document
        .querySelector<HTMLButtonElement>("#full-close")!
        .addEventListener("click", () => fullEl.close());

      const liveEl = document.querySelector<HTMLDivElement>("#live")!;
      const draftEl = document.querySelector<HTMLSpanElement>("#draft")!;
      const beatEl = document.querySelector<HTMLSpanElement>("#beat")!;
      const expandEl = document.querySelector<HTMLButtonElement>("#expand")!;
      const screenEl = document.querySelector<HTMLDialogElement>("#screen")!;
      const screenViewEl = screenEl.querySelector<HTMLDivElement>(".body")!;
      const screenBodyEl = screenEl.querySelector<HTMLPreElement>("pre")!;
      const screenCloseEl =
        document.querySelector<HTMLButtonElement>("#screen-close")!;

      let screenText = "";

      /** Both sheets end where the composer begins, and so does the veil. */
      function sizeSheets() {
        document.documentElement.style.setProperty(
          "--composer-h",
          `${composerEl.getBoundingClientRect().height}px`,
        );
      }

      /** `clientWidth` and `clientHeight` carry the padding, and a screen
       *  scaled against those loses that much off its right and bottom. */
      function contentBox(el: HTMLElement) {
        const style = getComputedStyle(el);
        const shrink = (size: number, a: string, b: string) =>
          size - parseFloat(a) - parseFloat(b);
        return {
          width: shrink(el.clientWidth, style.paddingLeft, style.paddingRight),
          height: shrink(el.clientHeight, style.paddingTop, style.paddingBottom),
        };
      }

      /** Scaled, not scrolled: the screen is a grid of characters whose boxes
       *  wrapping would break, and the reader wants the whole of it at once. */
      function fitScreen() {
        if (!screenEl.open) return;
        screenBodyEl.style.setProperty("--fit", "1");
        const box = contentBox(screenViewEl);
        const scale = Math.min(
          box.width / (screenBodyEl.scrollWidth || 1),
          box.height / (screenBodyEl.scrollHeight || 1),
          1,
        );
        screenBodyEl.style.setProperty("--fit", String(scale));
      }

      function paintLive(live: Live, state: string) {
        draftEl.textContent = live.composer;
        beatEl.hidden = state !== "working";
        screenText = live.screen;
        if (screenEl.open && screenBodyEl.textContent !== live.screen) {
          screenBodyEl.textContent = live.screen;
          fitScreen();
        }
      }

      /** Leaving a pane must not leave its draft, its screen, or its animation behind
       *  for the next one to show for a tick. */
      function resetLive() {
        draftEl.textContent = "";
        beatEl.hidden = true;
        screenText = "";
        screenBodyEl.textContent = "";
        if (screenEl.open) screenEl.close();
      }

      // The screen is where a /model picker lives: it never reaches the transcript,
      // and the pane's status stays `idle` while one is open, so the button is
      // offered in every state rather than gated on `blocked`.
      expandEl.addEventListener("click", () => {
        screenBodyEl.textContent = screenText;
        sizeSheets();
        // show(), not showModal(): a picker on the screen is answered with the
        // controls below it, which a modal would make inert.
        screenEl.show();
        screenViewEl.focus();
        fitScreen();
      });

      screenCloseEl.addEventListener("click", () => screenEl.close());

      // A non-modal dialog gets no Escape handling of its own.
      addEventListener("keydown", (event) => {
        if (event.key === "Escape" && screenEl.open) screenEl.close();
      });

      // A rotation or an on-screen keyboard moves the composer and changes what
      // fits; both sheets are measured against it.
      addEventListener("resize", () => {
        if (!fullEl.open && !screenEl.open) return;
        sizeSheets();
        fitScreen();
      });

      const POLL_MS = 3000;
      /** The session is smaller and changes slower than pane output. */
      const SESSION_POLL_MS = 5000;
      /** Matches the server default; each "earlier output" widens the window. */
      const LINES = 300;
      const MAX_LINES = 20000;

      let session: Session | null = null;
      let watching: string | null = null;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let sessionJson = "";
      let loading = false;
      let sessionFailed = false;
      let watches = 0;
      let lines = LINES;
      let painted = "";

      function say(message: string, failed = false) {
        statusEl.textContent = message;
        statusEl.classList.toggle("error", failed && message !== "");
      }

      /** A dropped tunnel is not a fault to report, it is something to retry. */
      function complain(error: unknown, fallback: string) {
        if (isTransient(error)) return say("Reconnecting…", true);
        say(error instanceof Error ? error.message : fallback, true);
      }

      // textContent throughout: labels are terminal titles, not our markup.
      const indicatorLabels: Record<StateIndicator, string> = {
        transparent: "unknown",
        gray: "idle or done",
        green: "working",
        yellow: "needs action",
      };

      function row(
        path: string,
        name: string,
        subtitle: string,
        indicator: StateIndicator,
      ) {
        const link = document.createElement("a");
        link.href = path;
        link.className = "row";
        link.dataset.indicator = indicator;
        link.ariaLabel = `${name}, ${subtitle}, ${indicatorLabels[indicator]}`;

        const nameEl = document.createElement("span");
        nameEl.className = "name";
        nameEl.textContent = name;
        const subtitleEl = document.createElement("span");
        subtitleEl.className = "subtitle";
        subtitleEl.textContent = subtitle;

        link.append(nameEl, subtitleEl);
        return link;
      }

      function workspaceRow(workspace: Workspace) {
        const count =
          workspace.tabs.length === 1 ? "1 tab" : `${workspace.tabs.length} tabs`;
        return row(
          href({ workspaceId: workspace.id }),
          workspace.label,
          count,
          stateIndicator(
            workspace.tabs.flatMap((tab) => tab.panes.map((pane) => pane.state)),
          ),
        );
      }

      function tabRow(workspace: Workspace, tab: Tab) {
        const count = tab.panes.length === 1 ? "1 pane" : `${tab.panes.length} panes`;
        return row(
          href({ workspaceId: workspace.id, tabId: tab.id }),
          tab.label,
          count,
          stateIndicator(tab.panes.map((pane) => pane.state)),
        );
      }

      // Reading the tail is the point, so follow it — unless the reader has
      // scrolled up, in which case leave them where they are.
      function paint(text: string) {
        // Rewriting textContent drops the scroll position, so an unchanged poll
        // used to yank the view every few seconds. Same bytes, same DOM.
        if (text === painted) return;
        const following =
          logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 8;
        const top = logEl.scrollTop;
        painted = text;
        logEl.textContent = text;
        logEl.scrollTop = following ? logEl.scrollHeight : top;
      }

      async function watch(pane: Pane | null) {
        const token = ++watches;
        clearTimeout(timer);
        if (watching && watching !== pane?.id) closePane(watching);
        watching = pane?.id ?? null;
        cards = [];
        paintedCards = [];
        painted = "";
        logEl.textContent = "";
        lines = LINES;
        transcriptEl.replaceChildren(moreEl);
        transcriptEl.hidden = true;
        logEl.hidden = true;
        liveEl.hidden = true;
        moreEl.hidden = true;
        resetLive();
        if (!pane) return;

        forgetPane(pane.id);
        liveEl.hidden = !pane.agent;
        await openPane(pane.id).catch(() => {});
        if (token !== watches) return;

        const loop = async () => {
          if (!document.hidden) {
            try {
              await tick(token);
              if (token !== watches) return;
              if (statusEl.classList.contains("error")) say("");
            } catch (error) {
              if (token !== watches) return;
              complain(error, "could not read the pane");
            }
          }
          if (token === watches) timer = setTimeout(loop, POLL_MS);
        };
        void loop();
      }

      async function tick(token: number) {
        // The session poll replaces the pane object as its state and agent change,
        // and `render()` does not restart a watch whose id is unchanged.
        const pane = current().pane;
        if (!pane || token !== watches) return;

        const polled = pane.agent
          ? await fetchAgentTick(
              pane.id,
              () => AbortSignal.timeout(15000),
              () => token === watches,
              (live) => {
                if (live) paintLive(live, pane.state);
                liveEl.hidden = false;
              },
            )
          : { live: undefined, liveError: undefined, page: null };
        if (polled === null) return;
        const { live, liveError, page } = polled;
        if (!pane.agent) liveEl.hidden = true;
        if (token !== watches) return;

        if (page !== null) {
          transcriptEl.hidden = false;
          parkMore(true);
          logEl.hidden = true;
          if (page !== "unchanged") {
            cards = replaceTail(cards, page.messages);
            paintCards();
            moreEl.hidden = !page.has_more;
          }
        } else {
          // Raw output: an agent pane keeps the visible screen, whose redraw history
          // does not churn, and a shell keeps its scrollback.
          cards = [];
          transcriptEl.hidden = true;
          if (pane.agent) {
            const raw = agentRawState(live?.screen);
            if (raw) {
              paint(raw.text);
              logEl.hidden = raw.hidden;
            }
            moreEl.hidden = true;
          } else {
            logEl.hidden = false;
            parkMore(false);
            const output = await fetchOutput(
              pane.id,
              lines,
              "scrollback",
              AbortSignal.timeout(15000),
            );
            if (token !== watches) return;
            paint(output.text);
            moreEl.hidden = !output.truncated || lines >= MAX_LINES;
          }
        }

        // The transcript is the durable surface, so a failed live read is
        // reported only after the transcript request had its chance to paint.
        if (liveError !== undefined) throw liveError;
      }

      addEventListener("pagehide", () => {
        if (watching) closePane(watching);
      });

      /** The URL is the state: everything on screen is derived from it. */
      function render() {
        if (!session) return;
        const { route, workspace, tab, pane: found } = current();
        const pane = found ?? null;

        // A workspace, tab, or pane can close between two renders; drop back
        // rather than leaving a dead target addressable in the composer.
        if (route.workspaceId && !workspace) {
          go("/", true);
          say("That workspace is gone.", true);
          return;
        }
        if (route.tabId && !tab) {
          go(href({ workspaceId: workspace!.id }), true);
          say("That tab is gone.", true);
          return;
        }
        if (route.paneId && !pane) {
          go(href({ workspaceId: workspace!.id, tabId: tab!.id }), true);
          say("That pane is gone.", true);
          return;
        }

        headingEl.textContent = pane
          ? paneTitle(pane)
          : (tab?.label ?? workspace?.label ?? "Herdr Remote");
        backEl.hidden = !workspace;
        backEl.href = pane
          ? href({ workspaceId: workspace!.id, tabId: tab!.id })
          : tab
            ? href({ workspaceId: workspace!.id })
            : "/";

        listEl.hidden = pane !== null;
        if (!pane) { logEl.hidden = true; transcriptEl.hidden = true; }
        if (!pane) {
          listEl.replaceChildren(
            ...(tab
              ? tab.panes.map((candidate) =>
                  row(
                    href({
                      workspaceId: workspace!.id,
                      tabId: tab.id,
                      paneId: candidate.id,
                    }),
                    candidate.label,
                    paneSubtitle(candidate),
                    stateIndicator([candidate.state]),
                  ),
                )
              : workspace
                ? workspace.tabs.map((candidate) => tabRow(workspace, candidate))
                : session.workspaces.map(workspaceRow)),
          );
        }
        if ((pane?.id ?? null) !== watching) {
          void watch(pane);
          if (pane) textEl.focus();
        }

        // Which pane, and what it is doing, are the heading's and the
        // indicators' job; all this line has left to say is that neither
        // exists yet.
        targetEl.textContent = pane ? "" : "Pick a pane first.";
        textEl.disabled = !pane;
        // "go" and "don't stop until completion" are instructions to an agent.
        // A plain shell would run them as a command line, and the apostrophe
        // would leave it hanging in a quote.
        // Arrows move the selection in a menu an agent is showing; a shell has
        // no menu, and the server refuses them there anyway.
        goEl.disabled = pushEl.disabled = upEl.disabled = downEl.disabled =
          !pane?.agent;
        // Mid-turn the button is esc; otherwise it clears the agent's context.
        stopEl.disabled = !pane?.agent;
        const stop = stopPresentation(pane?.state ?? "");
        stopEl.dataset.icon = stop.icon;
        stopEl.ariaLabel = stopEl.title = stop.label;
        syncSend();
      }

      /** Everything on screen derives from the URL; this is the one place that
       *  resolves it against the session. */
      function current(): {
        route: Route;
        workspace?: Workspace;
        tab?: Tab;
        pane?: Pane;
      } {
        const route = parseRoute(location.pathname);
        const workspace = session?.workspaces.find(
          (candidate) => candidate.id === route.workspaceId,
        );
        const tab = workspace?.tabs.find((candidate) => candidate.id === route.tabId);
        const pane = tab?.panes.find((candidate) => candidate.id === route.paneId);
        return { route, workspace, tab, pane };
      }

      /** With nothing typed the same button sends the Enter key, which only an
       *  agent's own question wants — a shell would execute its half-typed line.
       *  With text, anyone can send: prompt handles shells with send_input. */
      function syncSend() {
        const empty = textEl.value.trim() === "";
        sendEl.disabled = textEl.disabled || (empty && !current().pane?.agent);
        sendEl.classList.toggle("empty", empty);
        const what = empty ? "Enter" : "Send";
        sendEl.title = what;
        sendEl.setAttribute("aria-label", what);
      }

      function go(path: string, replace = false) {
        history[replace ? "replaceState" : "pushState"]({}, "", path);
        render();
      }

      async function load() {
        // Single flight: a request is allowed 15 s, the tick fires every 5 s.
        // Lapping it would mean every slow success arrives pre-superseded and
        // the session never lands on a slow tunnel — the case the poll exists for.
        if (loading) return;
        loading = true;
        try {
          const fresh = await fetchSession(AbortSignal.timeout(15000));
          // Touch only messages this function owns: "Loading…" (boot and manual
          // refresh) and its own earlier failure. watch()'s errors are its
          // business — wiping them here would flicker a genuinely failing pane
          // read every 5 s.
          if (statusEl.textContent === "Loading…") {
            say(fresh.workspaces.length ? "" : "No workspaces.");
          } else if (sessionFailed) {
            say(""); // our own recovery; watch re-asserts its errors within 3 s
          }
          sessionFailed = false;
          // Same bytes, same DOM — the steady poll must not churn the list.
          const json = JSON.stringify(fresh);
          if (json !== sessionJson) {
            sessionJson = json;
            session = fresh;
            render();
          }
        } catch (error) {
          sessionFailed = true;
          complain(error, "Could not load.");
        } finally {
          loading = false;
        }
      }

      // Coming back to the app resyncs at once rather than after a poll: the
      // phone will have slept, and WARP reconnects on its own schedule.
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) load();
      });
      // The steady poll is also the retry: a failed load is simply stale until
      // the next tick, and a backgrounded tab polls nothing.
      setInterval(() => {
        if (!document.hidden) load();
      }, SESSION_POLL_MS);

      // Same-origin links move the app, not the browser. Modified clicks keep
      // their usual meaning (new tab, download).
      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>("a");
        if (!link || link.origin !== location.origin) return;
        event.preventDefault();
        go(link.pathname);
      });

      window.addEventListener("popstate", render);

      /** The action buttons differ only in what they send. */
      async function act(
        button: HTMLButtonElement,
        what: string,
        run: (paneId: string) => Promise<void>,
      ) {
        const pane = current().pane;
        if (!pane || button.disabled) return;
        button.disabled = true;
        say(`${what}…`);
        try {
          await run(pane.id);
          say("");
        } catch (error) {
          complain(error, `Could not send ${what}.`);
        } finally {
          // render() restores each button from the pane's current state,
          // including the stop/clear presentation.
          render();
        }
      }

      stopEl.addEventListener("click", () => {
        const stop = stopPresentation(current().pane?.state ?? "");
        return act(stopEl, stop.label, (id) =>
          stop.interrupts ? interruptPane(id) : sendPrompt(id, "/clear"),
        );
      });
      goEl.addEventListener("click", () =>
        act(goEl, "go", (id) => sendPrompt(id, "go")),
      );
      pushEl.addEventListener("click", () =>
        act(pushEl, "don't stop until completion", (id) =>
          sendPrompt(id, "don't stop until completion"),
        ),
      );
      upEl.addEventListener("click", () =>
        act(upEl, "up", (id) => pressArrow(id, "up")),
      );
      downEl.addEventListener("click", () =>
        act(downEl, "down", (id) => pressArrow(id, "down")),
      );
      textEl.addEventListener("input", () => {
        syncSend();
        // Past five rows the box stops growing and the caret can sit below the
        // fold. Only when typing at the very end: mid-text edits keep their view.
        if (textEl.selectionStart === textEl.value.length) {
          textEl.scrollTop = textEl.scrollHeight;
        }
      });

      composerEl.addEventListener("submit", (event) => {
        event.preventDefault();
        const text = textEl.value.trim();
        if (!text) {
          act(sendEl, "Enter", (id) => pressEnter(id));
          return;
        }
        act(sendEl, "message", async (id) => {
          await sendPrompt(id, text);
          textEl.value = "";
          syncSend();
        });
      });

      // Reading further back keeps the reader where they are: paint() only
      // follows the tail when they were already at it.
      moreEl.addEventListener("click", async () => {
        const paneId = watching;
        const token = watches;
        if (!paneId) return;
        if (transcriptEl.hidden) {
          lines = Math.min(lines * 4, MAX_LINES);
          moreEl.hidden = true;
          return;
        }
        const oldest = cards[0]?.seq;
        const page = await fetchTranscript(paneId, oldest);
        if (token !== watches || paneId !== watching) return;
        if (page === null || page === "unchanged") return;
        const fromBottom = transcriptEl.scrollHeight - transcriptEl.scrollTop;
        cards = prepend(page.messages, cards);
        paintCards();
        transcriptEl.scrollTop = transcriptEl.scrollHeight - fromBottom;
        moreEl.hidden = !page.has_more;
      });

      // On a touch screen the reload control is not a button to find but a drag
      // from the top of the log: pull down, the icon comes with it, let go past
      // the threshold and it loads. `overscroll-behavior-y` keeps the browser's
      // own pull-to-refresh out of the way.
      const logareaEl = document.querySelector<HTMLDivElement>("#logarea")!;
      const PULL_LIMIT = 72;
      const PULL_TRIGGER = 56;
      let pullFrom: number | null = null;
      let pulled = 0;

      function pullScroller(): HTMLElement | null {
        if (!transcriptEl.hidden) return transcriptEl;
        if (!logEl.hidden) return logEl;
        return null;
      }

      logareaEl.addEventListener(
        "touchstart",
        (event) => {
          const scroller = pullScroller();
          pulled = 0;
          pullFrom =
            !moreEl.hidden && scroller !== null && scroller.scrollTop <= 0
              ? event.touches[0].clientY
              : null;
        },
        { passive: true },
      );

      logareaEl.addEventListener(
        "touchmove",
        (event) => {
          if (pullFrom === null) return;
          pulled = Math.max(
            0,
            Math.min(PULL_LIMIT, event.touches[0].clientY - pullFrom),
          );
          moreEl.style.setProperty("--pull", `${pulled}px`);
        },
        { passive: true },
      );

      logareaEl.addEventListener("touchend", () => {
        const load = pullFrom !== null && pulled >= PULL_TRIGGER;
        pullFrom = null;
        pulled = 0;
        moreEl.style.removeProperty("--pull");
        if (load) moreEl.click();
      });

      refreshEl.addEventListener("click", () => {
        say("Loading…");
        load();
      });
      say("Loading…");
      load();
    </script>

    <style is:global>
      /* Global, not scoped: the rows below are built in JS and so never carry
         Astro's data-astro-cid attribute. */
      :root {
        --edge: color-mix(in srgb, currentColor 15%, transparent);
        --muted: color-mix(in srgb, currentColor 60%, transparent);
        /* The user's hue and chroma are the favicon's own — 66,249 of its
           chromatic pixels average 189.3deg — at OKLCH lightness 0.3456, the
           darkness the mark uses. The agent's is the first draft's own value,
           kept because the operator prefers it: a near-black that reads as the
           page rather than as a card, which is the point when only one side of
           the conversation is being answered. Against white text they measure
           11.19:1 and 17.04:1. */
        --card-user: #004340;
        --card-agent: #1c1c1c;
        --full-gap: 1rem;
      }
      /* The page owns its overscroll: a downward drag is the transcript's
         "load earlier" gesture, not the browser's reload. */
      html,
      body {
        overscroll-behavior-y: contain;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        max-height: 100dvh;
        margin: 0 auto;
        max-width: 36rem;
        font: 1rem/1.5 system-ui, sans-serif;
      }
      /* Every child carries the page's 1rem inset itself. On a scrolling one
         that puts the bar at the page's edge, outside the text, which is the
         whole reason the padding is not on the body. */
      noscript {
        display: block;
      }
      header,
      noscript,
      #status {
        padding: 0 1rem;
      }
      header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 6px 0;
      }
      h1 {
        flex: 1;
        align-self: center;
        overflow: hidden;
        /* margin: 0 matters as much as the size here — the UA default adds
           0.67em above and below, which was most of the old header. */
        margin: 0;
        font-size: 0.95rem;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      #status {
        color: var(--muted);
      }
      #status:empty {
        display: none;
      }
      #status.error {
        color: inherit;
        font-weight: 600;
      }
      /* One positioned column for whichever view is showing, so the pull
         control can sit on its top edge and the hammer on its bottom one. It
         only claims the column's spare height when it has something to show;
         otherwise the pane list keeps it. */
      #logarea {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      #logarea:has(> :not([hidden])) {
        flex: 1;
      }
      /* A reload icon that rides at the very top of the scrolling history, so
         reaching the oldest card is what brings it into view. A drag from the
         top on a touch screen turns it as it goes and loads on release. */
      #more {
        display: grid;
        place-items: center;
        flex: none;
        width: 100%;
        /* Air above the icon, and the list's own gap supplying as much below,
           so the control sits evenly between the edge and the oldest card. */
        padding: 0.5rem 0 0;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
      }
      #more svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        transform: rotate(calc(var(--pull, 0px) * 4deg));
      }
      #transcript {
        flex: 1;
        list-style: none;
        margin: 0;
        padding: 0 1rem 0.5rem;
        overflow-y: auto;
        overscroll-behavior: contain;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      /* Older WebViews do not mark the UA `[hidden]` rule `!important`, so a
         `display` of our own would win over it — the same reason `#log[hidden]`
         already exists below. */
      #transcript[hidden],
      #live[hidden],
      #more[hidden],
      #beat[hidden] {
        display: none;
      }
      #transcript li {
        border-radius: 10px;
      }
      #transcript li > button {
        display: block;
        width: 100%;
        border: 0;
        border-radius: inherit;
        padding: 0.5rem 0.7rem;
        color: inherit;
        background: transparent;
        font: inherit;
        text-align: left;
        cursor: pointer;
      }
      #transcript li[data-role="user"] {
        margin-left: 15%;
        background: var(--card-user);
      }
      /* The agent lane is nearly the page's own colour, so it takes the same
         1px the pane rows use to stand apart from it. */
      #transcript li[data-role="assistant"] {
        border: 1px solid var(--edge);
        background: var(--card-agent);
      }
      /* Plain text in one node, which is what lets the clamp cut at three lines and
         append its ellipsis; markup would give it block children to trip on. */
      .preview {
        margin: 0;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        overflow: hidden;
      }
      /* Both sheets go edge to edge and over the header, with air above and
         below, and both stop where the composer begins. What differs is who
         may act while one is open: a message is read with showModal(), which
         inerts the controls beneath it, and the screen with show(), because a
         picker on it is answered with those very controls. The only edges
         either draws are the two the composer already draws. */
      #full,
      #screen {
        position: fixed;
        top: var(--full-gap);
        left: 0;
        right: 0;
        z-index: 10;
        box-sizing: border-box;
        width: auto;
        height: calc(100dvh - var(--composer-h, 9rem) - var(--full-gap) * 2);
        max-width: none;
        max-height: none;
        flex-direction: column;
        margin: 0;
        padding: 0;
        border-width: 1px 0;
        border-style: solid;
        border-color: var(--edge);
        border-radius: 0;
        overflow: hidden;
        color: inherit;
      }
      /* Reading a message is that card enlarged, so the sheet is its colour.
         The screen is the terminal, and keeps the page's own. */
      #full {
        background: var(--card-agent);
      }
      #screen {
        background: Canvas;
      }
      /* Scoped to [open]: an unscoped display would beat the UA's own
         `dialog:not([open]) { display: none }` and leave both sheets on. */
      #full[open],
      #screen[open] {
        display: flex;
      }
      /* The veil covers what the sheet took over and stops at the controls;
         the UA backdrop would cover those too. */
      #full::backdrop {
        background: transparent;
      }
      body:has(dialog[open])::after {
        position: fixed;
        inset: 0 0 var(--composer-h, 9rem);
        z-index: 9;
        background: rgb(0 0 0 / 0.55);
        content: "";
      }
      /* showModal() does the inerting; this is the matching dim, the one the
         panel already wears with no pane picked. */
      body:has(#full[open]) #composer {
        opacity: 0.55;
      }
      /* The close control floats over the foot of the sheet; the padding is
         the room it needs, inside the scroller so the end of a long message
         clears it too, and inside the box `fitScreen` measures so a screen is
         never scaled under it. */
      #full .body,
      #screen .body {
        flex: 1;
        min-height: 0;
        padding: 0.5rem 0.75rem 3rem;
        /* Both sheets park focus on their text rather than on the close
           control, which is where the dialog focusing steps would put it. */
        outline: none;
      }
      #full .body {
        overflow: auto;
        overscroll-behavior: contain;
      }
      #full .body.wrap {
        white-space: pre-wrap;
      }
      #full .body pre,
      #full .body table {
        display: block;
        overflow-x: auto;
      }
      /* A terminal screen is a fixed grid whose boxes wrapping would break, so
         it is scaled to whatever fits instead of scrolled. */
      #screen .body {
        overflow: hidden;
      }
      #screen pre {
        width: max-content;
        margin: 0;
        font: 12px/1.35 ui-monospace, monospace;
        white-space: pre;
        transform: scale(var(--fit, 1));
        transform-origin: top left;
      }
      #full-close,
      #screen-close {
        position: absolute;
        right: 0.5rem;
        bottom: 0.5rem;
        display: grid;
        place-items: center;
        padding: 0.35rem;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
      }
      #full-close svg,
      #screen-close svg {
        width: 24px;
        height: 24px;
      }
      #live {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 1rem;
        border-top: 1px solid var(--line, #333);
      }
      /* One line, ellipsised — the treatment .name and .subtitle already use. */
      #draft {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: ui-monospace, monospace;
        opacity: 0.75;
      }
      /* The hammer holds the band's left edge and the screen button its right,
         with the draft between them. */
      #beat {
        display: grid;
        place-items: center;
        pointer-events: none;
      }
      #beat svg {
        width: 26px;
        height: 26px;
        overflow: visible; /* the head leaves the 24-unit box when it swings */
      }
      #expand {
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
      }
      #expand svg {
        width: 22px;
        height: 22px;
      }
      #beat g {
        transform-origin: 17% 89%; /* the handle's tip */
        animation: strike 1.1s ease-in-out infinite;
      }
      @keyframes strike {
        0%, 45% { transform: rotate(-32deg); }
        62%     { transform: rotate(6deg); }
        70%     { transform: rotate(-6deg); }
        78%     { transform: rotate(2deg); }
        100%    { transform: rotate(-32deg); }
      }
      @media (prefers-reduced-motion: reduce) {
        #beat g { animation: none; }
      }
      /* The list and the log scroll; the composer keeps its own space in the
         column, so neither can end up underneath it. */
      #list,
      #log {
        flex: 1;
        padding: 0 1rem;
        overflow-y: auto;
        overscroll-behavior: contain;
      }
      #log {
        margin: 0;
        /* Air between the last line and the composer's border, so the history
           does not read as glued to the controls. */
        padding-bottom: 0.5rem;
        font: 0.8rem/1.4 ui-monospace, monospace;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .row {
        position: relative;
        display: block;
        margin-bottom: 0.5rem;
        padding: 0.75rem 2rem 0.75rem 0.75rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        color: inherit;
        text-decoration: none;
      }
      .row::after {
        position: absolute;
        top: 50%;
        right: 0.75rem;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: transparent;
        content: "";
        transform: translateY(-50%);
      }
      .row[data-indicator="gray"]::after {
        background: #9ca3af;
      }
      .row[data-indicator="green"]::after {
        background: #22c55e;
      }
      .row[data-indicator="yellow"]::after {
        background: #eab308;
      }
      .name {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .subtitle {
        display: block;
        font-size: 0.85rem;
        color: var(--muted);
      }
      #composer {
        display: grid;
        /* 6px above and below the pane label, matching the header's air. */
        gap: 6px;
        padding: 6px 1rem calc(6px + env(safe-area-inset-bottom));
        border-top: 1px solid var(--edge);
        background: Canvas;
      }
      /* Disabled-for-lack-of-a-pane dims the panel; a single disabled button
         (stop on an idle agent, say) is its own 0.35 opacity, not the panel's. */
      #composer:has(textarea:disabled) {
        opacity: 0.55;
      }
      #target {
        font-size: 0.85rem;
        color: var(--muted);
      }
      #target:empty {
        display: none;
      }
      /* Two rows to start, growing with what is typed and capped at five —
         past that it scrolls. field-sizing does the growing; `rows` is the
         floor a browser without it lands on. The bounds are border-box, so
         they carry the 0.5rem padding and the 1px border themselves. */
      textarea {
        box-sizing: border-box;
        field-sizing: content;
        min-height: calc(2lh + 1rem + 2px);
        max-height: calc(5lh + 1rem + 2px);
        padding: 0.5rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
        font-size: 0.85rem;
        resize: vertical;
      }
      /* Equal columns, not `flex: 1` — a flex item's share follows its content,
         so the padding-less arrow pair came out narrower than its neighbours.
         minmax(0,1fr) so a narrow phone tightens the buttons instead of
         pushing the page wider than its viewport. */
      #actions {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.5rem;
      }
      #actions button {
        display: grid;
        place-items: center;
      }
      /* lucide is stroke-drawn throughout. */
      svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      /* One button, two jobs: the paper plane once there is something to send,
         the return arrow while the composer is empty. */
      #actions button.empty .send,
      #actions button:not(.empty) .enter {
        display: none;
      }
      #stop[data-icon="hand"] .eraser,
      #stop[data-icon="eraser"] .hand {
        display: none;
      }
      #actions button:disabled {
        opacity: 0.35;
      }
      /* 36px, two thirds of the 54px the row used to stand at, and a border-box
         height so the number on the page is the number here. */
      #composer button {
        box-sizing: border-box;
        min-height: 36px;
        padding: 4px;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
      }
      /* One slot, two keys, side by side: stacked, the pair set the row's
         height, and two thirds of that leaves each key under the 24px WCAG 2.2
         AA floor (2.5.8). Sharing the slot's width keeps both keys the full
         36px tall. Must follow the rule above, which it overrides. */
      #nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
      }
      #nav button {
        padding: 0;
      }
      /* 24px is the WCAG 2.2 AA floor (2.5.8), below Apple's 44pt guidance —
         a deliberate trade for a header that does not dominate a phone screen.
         Fixed height so the pair matches whatever it holds. */
      #refresh svg,
      #back svg {
        width: 14px;
        height: 14px;
      }
      #refresh,
      #back {
        box-sizing: border-box;
        display: grid;
        place-items: center;
        height: 24px;
        min-width: 24px;
        padding: 0 0.35rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
      }
      /* Older WebViews do not mark the UA [hidden] rule !important. */
      #more[hidden],
      #back[hidden],
      #list[hidden],
      #log[hidden] {
        display: none;
      }
    </style>
  </body>
</html>

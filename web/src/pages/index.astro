<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="color-scheme" content="light dark" />
    <title>Herdr Remote</title>
  </head>
  <body>
    <header>
      <h1>Herdr Remote</h1>
      <button id="refresh" type="button" aria-label="Reload panes">&#8635;</button>
    </header>

    <noscript>This page needs JavaScript to list panes and send prompts.</noscript>
    <p id="status" role="status"></p>
    <div id="tabs" role="radiogroup" aria-label="Panes"></div>

    <form id="composer" hidden>
      <label for="text" id="target"></label>
      <textarea
        id="text"
        rows="4"
        enterkeyhint="send"
        placeholder="Type an instruction…"></textarea>
      <button type="submit">Send</button>
    </form>

    <script>
      import {
        fetchSession,
        paneSubtitle,
        sendPrompt,
        type Pane,
        type Tab,
      } from "../lib/api";

      const tabsEl = document.querySelector<HTMLDivElement>("#tabs")!;
      const statusEl = document.querySelector<HTMLParagraphElement>("#status")!;
      const composerEl = document.querySelector<HTMLFormElement>("#composer")!;
      const targetEl = document.querySelector<HTMLLabelElement>("#target")!;
      const textEl = document.querySelector<HTMLTextAreaElement>("#text")!;
      const refreshEl = document.querySelector<HTMLButtonElement>("#refresh")!;

      let selected: Pane | null = null;
      let generation = 0;

      function say(message: string, failed = false) {
        statusEl.textContent = message;
        statusEl.classList.toggle("error", failed && message !== "");
      }

      function markSelection() {
        for (const button of tabsEl.querySelectorAll("button")) {
          button.setAttribute(
            "aria-checked",
            button.dataset.paneId === selected?.id ? "true" : "false",
          );
        }
      }

      function select(pane: Pane) {
        selected = pane;
        targetEl.textContent = pane.label;
        composerEl.hidden = false;
        markSelection();
        textEl.focus();
      }

      function deselect() {
        selected = null;
        composerEl.hidden = true;
        targetEl.textContent = "";
      }

      // textContent throughout: pane labels are terminal titles, not our markup.
      function render(tabs: Tab[]) {
        tabsEl.replaceChildren();
        for (const tab of tabs) {
          const section = document.createElement("section");
          const heading = document.createElement("h2");
          heading.textContent = tab.label;
          section.append(heading);

          for (const pane of tab.panes) {
            const button = document.createElement("button");
            button.type = "button";
            button.role = "radio";
            button.dataset.paneId = pane.id;

            const name = document.createElement("span");
            name.className = "name";
            name.textContent = pane.label;
            const subtitle = document.createElement("span");
            subtitle.className = "subtitle";
            subtitle.textContent = paneSubtitle(pane);

            button.append(name, subtitle);
            button.addEventListener("click", () => select(pane));
            section.append(button);
          }
          tabsEl.append(section);
        }

        // A pane that has since closed must not stay addressable in the composer.
        const stillThere = tabs.some((tab) =>
          tab.panes.some((pane) => pane.id === selected?.id),
        );
        if (selected && !stillThere) {
          deselect();
          say("That pane is gone.", true);
        }
        markSelection();
      }

      async function load() {
        const mine = ++generation;
        say("Loading…");
        try {
          const session = await fetchSession(AbortSignal.timeout(15000));
          if (mine !== generation) return; // a newer refresh already painted
          render(session.tabs);
          if (statusEl.textContent === "Loading…") {
            say(session.tabs.length ? "" : "No panes.");
          }
        } catch (error) {
          if (mine !== generation) return;
          say(error instanceof Error ? error.message : "Could not load.", true);
        }
      }

      composerEl.addEventListener("submit", async (event) => {
        event.preventDefault();
        const pane = selected;
        const text = textEl.value.trim();
        if (!pane) return;
        if (!text) {
          say("Type something first.", true);
          return;
        }

        const submit = composerEl.querySelector("button")!;
        submit.disabled = true;
        say("Sending…");
        try {
          await sendPrompt(pane.id, text);
          textEl.value = "";
          say(`Sent to ${pane.label}.`);
        } catch (error) {
          say(error instanceof Error ? error.message : "Could not send.", true);
        } finally {
          submit.disabled = false;
        }
      });

      refreshEl.addEventListener("click", load);
      load();
    </script>

    <style is:global>
      /* Global, not scoped: the pane rows below are built in JS and so never
         carry Astro's data-astro-cid attribute. */
      :root {
        --edge: color-mix(in srgb, currentColor 15%, transparent);
        --muted: color-mix(in srgb, currentColor 60%, transparent);
        --accent: color-mix(in srgb, currentColor 8%, transparent);
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        margin: 0 auto;
        max-width: 34rem;
        padding: 0 1rem;
        font: 1rem/1.5 system-ui, sans-serif;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      h1 {
        font-size: 1.25rem;
      }
      h2 {
        margin: 1.5rem 0 0.5rem;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }
      #status {
        color: var(--muted);
      }
      #status:empty {
        display: none;
      }
      #status.error {
        color: inherit;
        font-weight: 600;
      }
      /* The list scrolls; the composer keeps its own space in the column, so a
         pane row can never end up underneath it. */
      #tabs {
        flex: 1;
        overflow-y: auto;
      }
      #tabs button {
        display: block;
        width: 100%;
        margin-bottom: 0.5rem;
        padding: 0.75rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
        text-align: left;
      }
      #tabs button[aria-checked="true"] {
        background: var(--accent);
        border-color: currentColor;
      }
      .name {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .subtitle {
        display: block;
        font-size: 0.85rem;
        color: var(--muted);
      }
      #composer {
        display: grid;
        gap: 0.5rem;
        padding: 0.75rem 0 calc(0.75rem + env(safe-area-inset-bottom));
        border-top: 1px solid var(--edge);
        background: Canvas;
      }
      /* Older WebViews do not mark the UA [hidden] rule !important. */
      #composer[hidden] {
        display: none;
      }
      #target {
        font-size: 0.85rem;
        color: var(--muted);
      }
      textarea {
        padding: 0.5rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
        resize: vertical;
      }
      #composer button,
      #refresh {
        min-height: 44px;
        padding: 0.75rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
      }
      #refresh {
        min-width: 44px;
        padding: 0.4rem 0.75rem;
      }
    </style>
  </body>
</html>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="color-scheme" content="light dark" />
    <title>Herdr Remote</title>
  </head>
  <body>
    <header>
      <a id="back" href="/" hidden aria-label="Back">&#8592;</a>
      <h1 id="heading">Herdr Remote</h1>
      <button id="refresh" type="button" aria-label="Reload">&#8635;</button>
    </header>

    <noscript>This page needs JavaScript to list panes and send prompts.</noscript>
    <p id="status" role="status"></p>
    <div id="list"></div>
    <button id="more" type="button" hidden>Load earlier output</button>
    <pre id="log" hidden></pre>

    <form id="composer">
      <label for="text" id="target"></label>
      <textarea
        id="text"
        rows="4"
        enterkeyhint="send"
        disabled
        placeholder="Type an instruction…"></textarea>
      <button type="submit" disabled>Send</button>
    </form>

    <script>
      import {
        fetchOutput,
        fetchSession,
        isTransient,
        paneSubtitle,
        sendPrompt,
        type Pane,
        type Session,
        type Tab,
      } from "../lib/api";
      import { href, parseRoute } from "../lib/route";

      const listEl = document.querySelector<HTMLDivElement>("#list")!;
      const logEl = document.querySelector<HTMLPreElement>("#log")!;
      const moreEl = document.querySelector<HTMLButtonElement>("#more")!;
      const statusEl = document.querySelector<HTMLParagraphElement>("#status")!;
      const headingEl = document.querySelector<HTMLHeadingElement>("#heading")!;
      const backEl = document.querySelector<HTMLAnchorElement>("#back")!;
      const composerEl = document.querySelector<HTMLFormElement>("#composer")!;
      const targetEl = document.querySelector<HTMLLabelElement>("#target")!;
      const textEl = document.querySelector<HTMLTextAreaElement>("#text")!;
      const sendEl = composerEl.querySelector<HTMLButtonElement>("button")!;
      const refreshEl = document.querySelector<HTMLButtonElement>("#refresh")!;

      const POLL_MS = 3000;
      /** Matches the server default; each "earlier output" widens the window. */
      const LINES = 300;
      const MAX_LINES = 20000;

      let session: Session | null = null;
      let watching: string | null = null;
      let timer: ReturnType<typeof setInterval> | undefined;
      let retry: ReturnType<typeof setTimeout> | undefined;
      let loads = 0;
      let watches = 0;
      let lines = LINES;

      function say(message: string, failed = false) {
        statusEl.textContent = message;
        statusEl.classList.toggle("error", failed && message !== "");
      }

      /** A dropped tunnel is not a fault to report, it is something to retry. */
      function complain(error: unknown, fallback: string) {
        if (isTransient(error)) return say("Reconnecting…", true);
        say(error instanceof Error ? error.message : fallback, true);
      }

      // textContent throughout: labels are terminal titles, not our markup.
      function row(path: string, name: string, subtitle: string) {
        const link = document.createElement("a");
        link.href = path;
        link.className = "row";

        const nameEl = document.createElement("span");
        nameEl.className = "name";
        nameEl.textContent = name;
        const subtitleEl = document.createElement("span");
        subtitleEl.className = "subtitle";
        subtitleEl.textContent = subtitle;

        link.append(nameEl, subtitleEl);
        return link;
      }

      function tabRow(tab: Tab) {
        const count = tab.panes.length === 1 ? "1 pane" : `${tab.panes.length} panes`;
        return row(href({ tabId: tab.id }), tab.label, count);
      }

      // Reading the tail is the point, so follow it — unless the reader has
      // scrolled up, in which case leave them where they are.
      function paint(text: string) {
        const following =
          logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 8;
        logEl.textContent = text;
        if (following) logEl.scrollTop = logEl.scrollHeight;
      }

      /** Poll the open pane's output; one pane is watched at a time. */
      function watch(pane: Pane | null) {
        clearInterval(timer);
        watching = pane?.id ?? null;
        // Each pane starts from the small window; widening is per visit.
        lines = LINES;
        moreEl.hidden = true;
        if (!pane) return;

        const mine = ++watches;
        const tick = async () => {
          if (document.hidden) return; // a backgrounded phone tab polls nothing
          try {
            const output = await fetchOutput(
              pane.id,
              lines,
              AbortSignal.timeout(15000),
            );
            if (mine !== watches) return; // a later pane already owns the view
            paint(output.text);
            // An agent pane in a full-screen TUI keeps no scrollback, so this
            // stays hidden there however far back the window reaches.
            moreEl.hidden = !output.truncated || lines >= MAX_LINES;
            // The interval keeps running through a failure, so the recovery is
            // what has to clear the warning it left behind.
            if (statusEl.classList.contains("error")) say("");
          } catch (error) {
            if (mine !== watches) return;
            // Keep polling a pane that is merely slow; a closed one shows up as
            // gone on the next session reload.
            complain(error, "Could not read.");
          }
        };
        logEl.textContent = "";
        tick();
        timer = setInterval(tick, POLL_MS);
      }

      /** The URL is the state: everything on screen is derived from it. */
      function render() {
        if (!session) return;
        const route = parseRoute(location.pathname);
        const tab = session.tabs.find((candidate) => candidate.id === route.tabId);
        const pane = tab?.panes.find((candidate) => candidate.id === route.paneId) ?? null;

        // A tab or pane can close between two renders; drop back rather than
        // leaving a dead target addressable in the composer.
        if (route.tabId && !tab) {
          go("/", true);
          say("That tab is gone.", true);
          return;
        }
        if (route.paneId && !pane) {
          go(href({ tabId: tab!.id }), true);
          say("That pane is gone.", true);
          return;
        }

        headingEl.textContent = pane ? pane.label : tab ? tab.label : "Herdr Remote";
        backEl.hidden = !tab;
        backEl.href = pane ? href({ tabId: tab!.id }) : "/";

        listEl.hidden = pane !== null;
        logEl.hidden = pane === null;
        if (!pane) {
          listEl.replaceChildren(
            ...(tab
              ? tab.panes.map((candidate) =>
                  row(
                    href({ tabId: tab.id, paneId: candidate.id }),
                    candidate.label,
                    paneSubtitle(candidate),
                  ),
                )
              : session.tabs.map(tabRow)),
          );
        }
        if ((pane?.id ?? null) !== watching) {
          watch(pane);
          if (pane) textEl.focus();
        }

        targetEl.textContent = pane ? paneSubtitle(pane) : "Pick a pane first.";
        textEl.disabled = sendEl.disabled = !pane;
      }

      function go(path: string, replace = false) {
        history[replace ? "replaceState" : "pushState"]({}, "", path);
        render();
      }

      async function load() {
        const mine = ++loads;
        clearTimeout(retry);
        say("Loading…");
        try {
          const fresh = await fetchSession(AbortSignal.timeout(15000));
          if (mine !== loads) return; // a newer reload already painted
          session = fresh;
          if (statusEl.textContent === "Loading…") {
            say(fresh.tabs.length ? "" : "No panes.");
          }
          render();
        } catch (error) {
          if (mine !== loads) return;
          complain(error, "Could not load.");
          // Stay connected for as long as the page is in front. A backgrounded
          // tab stops instead, and visibilitychange picks it back up.
          if (!document.hidden) retry = setTimeout(load, POLL_MS);
        }
      }

      // Coming back to the app resyncs at once rather than after a poll: the
      // phone will have slept, and WARP reconnects on its own schedule.
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) load();
      });

      // Same-origin links move the app, not the browser. Modified clicks keep
      // their usual meaning (new tab, download).
      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>("a");
        if (!link || link.origin !== location.origin) return;
        event.preventDefault();
        go(link.pathname);
      });

      window.addEventListener("popstate", render);

      composerEl.addEventListener("submit", async (event) => {
        event.preventDefault();
        const route = parseRoute(location.pathname);
        const pane = session?.tabs
          .find((tab) => tab.id === route.tabId)
          ?.panes.find((candidate) => candidate.id === route.paneId);
        const text = textEl.value.trim();
        if (!pane) return;
        if (!text) {
          say("Type something first.", true);
          return;
        }

        sendEl.disabled = true;
        say("Sending…");
        try {
          await sendPrompt(pane.id, text);
          textEl.value = "";
          say("");
        } catch (error) {
          say(error instanceof Error ? error.message : "Could not send.", true);
        } finally {
          sendEl.disabled = false;
        }
      });

      // Reading further back keeps the reader where they are: paint() only
      // follows the tail when they were already at it.
      moreEl.addEventListener("click", () => {
        lines = Math.min(lines * 4, MAX_LINES);
        moreEl.hidden = true;
        say("Reading further back…");
      });

      refreshEl.addEventListener("click", load);
      load();
    </script>

    <style is:global>
      /* Global, not scoped: the rows below are built in JS and so never carry
         Astro's data-astro-cid attribute. */
      :root {
        --edge: color-mix(in srgb, currentColor 15%, transparent);
        --muted: color-mix(in srgb, currentColor 60%, transparent);
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        max-height: 100dvh;
        margin: 0 auto;
        max-width: 34rem;
        padding: 0 1rem;
        font: 1rem/1.5 system-ui, sans-serif;
      }
      header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 6px;
      }
      h1 {
        flex: 1;
        overflow: hidden;
        /* margin: 0 matters as much as the size here — the UA default adds
           0.67em above and below, which was most of the old header. */
        margin: 0;
        font-size: 0.95rem;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      #status {
        color: var(--muted);
      }
      #status:empty {
        display: none;
      }
      #status.error {
        color: inherit;
        font-weight: 600;
      }
      /* The list and the log scroll; the composer keeps its own space in the
         column, so neither can end up underneath it. */
      #list,
      #log {
        flex: 1;
        overflow-y: auto;
        overscroll-behavior: contain;
      }
      #log {
        margin: 0;
        font: 0.8rem/1.4 ui-monospace, monospace;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .row {
        display: block;
        margin-bottom: 0.5rem;
        padding: 0.75rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        color: inherit;
        text-decoration: none;
      }
      .name {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .subtitle {
        display: block;
        font-size: 0.85rem;
        color: var(--muted);
      }
      #composer {
        display: grid;
        gap: 0.5rem;
        padding: 0.75rem 0 calc(0.75rem + env(safe-area-inset-bottom));
        border-top: 1px solid var(--edge);
        background: Canvas;
      }
      /* Disabled is a state, not a hidden panel: it stays in place and says why. */
      #composer:has(:disabled) {
        opacity: 0.55;
      }
      #target {
        font-size: 0.85rem;
        color: var(--muted);
      }
      textarea {
        padding: 0.5rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
        resize: vertical;
      }
      #composer button,
      #refresh,
      #back {
        min-height: 44px;
        padding: 0.75rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
      }
      /* 24px is the WCAG 2.2 AA floor (2.5.8), below Apple's 44pt guidance —
         a deliberate trade for a header that does not dominate a phone screen. */
      #refresh,
      #back {
        display: grid;
        place-items: center;
        min-width: 24px;
        min-height: 24px;
        padding: 0.15rem 0.35rem;
        font-size: 0.85rem;
        text-decoration: none;
      }
      #more {
        margin-bottom: 0.5rem;
        padding: 0.5rem;
        border: 1px solid var(--edge);
        border-radius: 0.5rem;
        background: none;
        color: inherit;
        font: inherit;
        font-size: 0.85rem;
      }
      /* Older WebViews do not mark the UA [hidden] rule !important. */
      #more[hidden],
      #back[hidden],
      #list[hidden],
      #log[hidden] {
        display: none;
      }
    </style>
  </body>
</html>
